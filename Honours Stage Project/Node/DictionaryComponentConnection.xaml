<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="DictionaryComponentConnection">
        <StackPanel>
            <Border BorderBrush="Black" BorderThickness="1" Height="2" Margin="0,5,0,5"/>
            <Button Content="Attributes" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding AddAttributeCommand}"/>
            <Button Content="Conditions" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding AddConditionCommand}"/>
            <Button Content="Outgoing" HorizontalAlignment="Right" Command="{Binding DataContext.AddOutwardConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
        </StackPanel>
        </DataTemplate>
</ResourceDictionary>