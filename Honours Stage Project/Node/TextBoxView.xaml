<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Honours_Stage_Project.Node.TextBoxView"
             Width="281" Height="200"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
             MouseMove="UserControl_MouseMove"
             MouseLeftButtonUp="UserControl_MouseLeftButtonUp">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DictionaryComponentConnection.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="Black" BorderThickness="2" Background="LightCyan" Margin="0,0,0,-11">
        <StackPanel Margin="0,8,0,-8">
            <Button Content="Incoming" Width="71" HorizontalAlignment="Left" Click="IncomingButton_Click"/>
            <TextBox x:Name="InputTextBox" Width="242" Height="91" Margin="10" HorizontalAlignment="Center"/>
            <ItemsControl x:Name="ConnectionComponent" ItemsSource ="{Binding TextBoxConnectionComponent}" ItemTemplate="{StaticResource DictionaryComponentConnection}" />
            <Button Content="Add Connection" Width="92" Height="20" Click="AddConnection_Click"/>
        </StackPanel>
    </Border>

</UserControl>