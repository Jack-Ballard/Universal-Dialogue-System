<UserControl x:Class="Honours_Stage_Project.Node.TextBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="281" Height="200"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
             MouseMove="UserControl_MouseMove"
             MouseLeftButtonUp="UserControl_MouseLeftButtonUp">
    <Border BorderBrush="Black" BorderThickness="2" Background="LightCyan" Margin="0,0,0,-11">
        <StackPanel Margin="0,8,0,-8">
            <Button Content="Incomming" Width="71" HorizontalAlignment="Left" Click="IncommingButton_Click"/>
            <TextBox x:Name="InputTextBox" Width="242" Height="91" Margin="10" HorizontalAlignment="Center"/>
            <ItemsControl x:Name="ConnectionComponent" ItemsSource="{Binding TextBoxConnectionComponent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border BorderBrush="Black" BorderThickness="1" Height="2" Margin="0,5,0,5"/>
                            <Button Content="Outgoing" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OutgoingButton_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add Connection" Width="92" Height="20" Click="AddConnection_Click"/>
        </StackPanel>
    </Border>

</UserControl>
