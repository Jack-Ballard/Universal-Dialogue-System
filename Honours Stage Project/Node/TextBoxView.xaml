<UserControl x:Class="Honours_Stage_Project.Node.TextBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="281" Height="200"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
             MouseMove="UserControl_MouseMove"
             MouseLeftButtonUp="UserControl_MouseLeftButtonUp">
    <Border BorderBrush="Black" BorderThickness="2" Background="LightCyan" Margin="0,0,0,-11">
        <StackPanel Margin="0,8,0,-8">
            <TextBlock Text="Complex Window" FontSize="16" HorizontalAlignment="Center" Margin="10"/>
            <TextBox Name="InputTextBox" Width="242" Height="91" Margin="10" HorizontalAlignment="Center"/>
            <ItemsControl Name="ConnectionComponent">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border BorderBrush="Black" BorderThickness="1" Height="2" Margin="0,5,0,5"/>
                            <Button Content="Connect Nodes" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add Connection" Width="92" Height="20" Click="AddConnection_Click"/>
        </StackPanel>
    </Border>

</UserControl>
