<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="OutgoingConnectionView.xaml"/>
    </ResourceDictionary.MergedDictionaries>

        <Style x:Key="DefaultOutgoingButtonStyle" TargetType="Button">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDefaultOutgoingVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ComponentConnectionView">
        <Border Background="Transparent">
            <StackPanel>

                <Border BorderBrush="Black" BorderThickness="1" Height="1" Margin="0,5,0,5"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Add Attribute" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding AddAttributeCommand}" Height="20" Width="80"/>
                    <Button Content="Add Condition" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding AddConditionCommand}" Height="20" Width="80"/>
                    <Button Content="Add Outgoing" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding AddOutgoingOptionCommand}" Height="20" Width="80"/>
                    <Button Content="-" Width="20" Height="20" Margin="2" Background="DarkGray"
                            Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Attributes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2"/>
                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="2"/>
                                <Button Content="-" Width="20" Height="20" Margin="2" Background="DarkGray"
                                        Command="{Binding DataContext.RemoveComponentAttributeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Conditions}" AlternationCount="1000">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Else If"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                             Value="0">
                                                    <Setter Property="Text" Value="If"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="180" Margin="2" />
                                <Button Content="-" Width="20" Height="20" Margin="2" Background="DarkGray"
                                        Command="{Binding DataContext.RemoveComponentConditionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Outgoing" Height="20" HorizontalAlignment="Right"
                        Command="{Binding AddDefaultOutgoingCommand}"
                        Style="{StaticResource DefaultOutgoingButtonStyle}"/>

                <ItemsControl ItemsSource="{Binding OutgoingConnections}" 
                              ItemTemplate="{StaticResource OutgoingConnectionView}"
                              Margin="0,4,0,0"/>

            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
