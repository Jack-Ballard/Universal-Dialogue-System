<Window x:Class="Honours_Stage_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Honours_Stage_Project"
        xmlns:nodeViews="clr-namespace:Honours_Stage_Project.Node"
        Title="MainWindow" Height="450" Width="800">

    <!-- Root grid layers: lines (bottom) → nodes → toolbar (top) -->
    <Grid>
        <!-- Background + lines drawn imperatively by code-behind -->
        <Canvas Name="LinesCanvas" Background="LightGray" IsHitTestVisible="False"/>

        <!-- Nodes positioned via Canvas.Left/Top bound to NodeViewModel.X/Y -->
        <ItemsControl Name="NodesControl" ItemsSource="{Binding Nodes}" Background="Transparent">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <nodeViews:NodeView/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Toolbar -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                    Orientation="Horizontal" Margin="5">
            <Button Content="Add Node" Command="{Binding AddNodeCommand}"
                    Width="75" Margin="0,0,5,0"/>
            <Button Content="Export"   Command="{Binding ExportCommand}"
                    Width="60"/>
        </StackPanel>
    </Grid>
</Window>
